PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/civicpulse
JWT_SECRET=change_this_secret
CLIENT_URL=http://localhost:5173
# true = users can log in without email verification (good for local dev)
AUTO_VERIFY=true
# Optional SMTP. If empty, emails are printed in the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
